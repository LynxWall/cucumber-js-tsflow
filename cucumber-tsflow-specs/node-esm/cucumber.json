{
	"tsnodeesm": {
		"paths": ["../features/**/*.feature"],
		"import": ["./src/step_definitions/**/*.ts"],
		"loader": ["ts-node-maintained/esm"],
		"format": [
			"behave:../reports/tsnodeesm.json",
			"html:../reports/tsnodeesm.html",
			"junitbamboo:../reports/tsnodeesm.xml"
		],
		"parallel": 1,
		"tags": "@node-esm and not @reload"
	},
	"esnodeesm": {
		"transpiler": "es-node-esm",
		"paths": ["../features/**/*.feature"],
		"import": ["./src/step_definitions/**/*.ts"],
		"format": ["behave:../reports/esnode.json", "html:../reports/esnode.html", "junitbamboo:../reports/esnode.xml"],
		"parallel": 0,
		"selectiveLoad": true,
		"tags": "@node-esm and not @reload"
	},
	"watch": {
		"transpiler": "es-node-esm",
		"paths": ["../features/basic-test.feature"],
		"import": ["./src/step_definitions/basic-test.ts", "./src/step_definitions/world-context.ts"],
		"format": ["progress"],
		"parallel": 0,
		"tags": "@node-esm"
	},
	"watch-tsnode": {
		"paths": ["../features/basic-test.feature"],
		"import": ["./src/step_definitions/basic-test.ts", "./src/step_definitions/world-context.ts"],
		"loader": ["ts-node-maintained/esm"],
		"format": ["progress"],
		"parallel": 0,
		"tags": "@node-esm"
	},
	"missing-import": {
		"transpiler": "es-node-esm",
		"paths": ["../features/basic-test.feature"],
		"import": [
			"./src/step_definitions/basic-test.ts",
			"./src/step_definitions/world-context.ts",
			"./src/fixtures/failing/missing-import.ts"
		],
		"format": ["progress"],
		"parallel": 0,
		"tags": "@node-esm"
	},
	"before-all-throws": {
		"transpiler": "es-node-esm",
		"paths": ["../features/basic-test.feature"],
		"import": [
			"./src/step_definitions/basic-test.ts",
			"./src/step_definitions/world-context.ts",
			"./src/fixtures/failing/before-all-throws.ts"
		],
		"format": ["progress"],
		"parallel": 0,
		"tags": "@node-esm"
	},
	"syntax-error": {
		"transpiler": "es-node-esm",
		"paths": ["../features/basic-test.feature"],
		"import": [
			"./src/step_definitions/basic-test.ts",
			"./src/step_definitions/world-context.ts",
			"./src/fixtures/failing/generated/syntax-error.ts"
		],
		"format": ["progress"],
		"parallel": 0,
		"tags": "@node-esm"
	},
	"syntax-error-tsnode": {
		"transpiler": "ts-node-esm",
		"paths": ["../features/basic-test.feature"],
		"import": [
			"./src/step_definitions/basic-test.ts",
			"./src/step_definitions/world-context.ts",
			"./src/fixtures/failing/generated/syntax-error.ts"
		],
		"format": ["progress"],
		"parallel": 0,
		"tags": "@node-esm"
	},
	"syntax-error-raw-loader": {
		"loader": ["ts-node-maintained/esm"],
		"paths": ["../features/basic-test.feature"],
		"import": [
			"./src/step_definitions/basic-test.ts",
			"./src/step_definitions/world-context.ts",
			"./src/fixtures/failing/generated/syntax-error.ts"
		],
		"format": ["progress"],
		"parallel": 0,
		"tags": "@node-esm"
	},
	"basic": {
		"transpiler": "es-node-esm",
		"paths": ["../features/basic-test.feature"],
		"import": ["./src/step_definitions/basic-test.ts", "./src/step_definitions/world-context.ts"],
		"format": ["progress"],
		"parallel": 0,
		"tags": "@node-esm"
	}
}
