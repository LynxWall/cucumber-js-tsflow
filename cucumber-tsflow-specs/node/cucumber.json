{
	"tsnode": {
		"transpiler": "ts-node",
		"paths": ["../features/**/*.feature"],
		"require": ["./src/step_definitions/**/*.ts"],
		"format": ["behave:../reports/tsnode.json", "html:../reports/tsnode.html", "junitbamboo:../reports/tsnode.xml"],
		"parallel": 1,
		"tags": "@node"
	},
	"esnode": {
		"transpiler": "es-node",
		"paths": ["../features/**/*.feature"],
		"require": ["./src/step_definitions/**/*.ts"],
		"format": ["behave:../reports/esnode.json", "html:../reports/esnode.html", "junitbamboo:../reports/esnode.xml"],
		"parallel": 0,
		"selectiveLoad": true,
		"tags": "@node"
	},
	"watch": {
		"transpiler": "es-node",
		"paths": ["../features/basic-test.feature"],
		"require": ["./src/step_definitions/basic-test.ts", "./src/step_definitions/world-context.ts"],
		"format": ["progress"],
		"parallel": 0,
		"tags": "@node"
	}
}
