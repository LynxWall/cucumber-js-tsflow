{
	"tsnode": {
		"transpiler": "ts-node",
		"paths": ["../features/**/*.feature"],
		"require": ["./src/step_definitions/**/*.ts"],
		"format": ["behave:../reports/tsnode.json", "html:../reports/tsnode.html", "junitbamboo:../reports/tsnode.xml"],
		"parallel": 1,
		"tags": "@node"
	},
	"esnode": {
		"transpiler": "es-node",
		"paths": ["../features/**/*.feature"],
		"require": ["./src/step_definitions/**/*.ts"],
		"format": ["behave:../reports/esnode.json", "html:../reports/esnode.html", "junitbamboo:../reports/esnode.xml"],
		"parallel": 0,
		"selectiveLoad": true,
		"tags": "@node"
	},
	"watch": {
		"transpiler": "es-node",
		"paths": ["../features/basic-test.feature"],
		"require": ["./src/step_definitions/basic-test.ts", "./src/step_definitions/world-context.ts"],
		"format": ["progress"],
		"parallel": 0,
		"tags": "@node"
	},
	"selective": {
		"transpiler": "es-node",
		"paths": ["../features/basic-test.feature"],
		"require": [
			"./src/step_definitions/basic-test.ts",
			"./src/step_definitions/background-test.ts",
			"./src/step_definitions/scenario-outline-test.ts",
			"./src/step_definitions/tag-test.ts",
			"./src/step_definitions/world-context.ts"
		],
		"format": ["progress"],
		"parallel": 0,
		"selectiveLoad": true,
		"tags": "@node"
	},
	"broken": {
		"transpiler": "es-node",
		"paths": ["./src/fixtures/broken/*.feature"],
		"require": ["./src/step_definitions/basic-test.ts", "./src/step_definitions/world-context.ts"],
		"format": ["progress", "message:../reports/parse-error.ndjson"],
		"parallel": 0,
		"tags": "@node"
	},
	"missing-import": {
		"transpiler": "es-node",
		"paths": ["../features/basic-test.feature"],
		"require": [
			"./src/step_definitions/basic-test.ts",
			"./src/step_definitions/world-context.ts",
			"./src/fixtures/failing/missing-import.ts"
		],
		"format": ["progress"],
		"parallel": 0,
		"tags": "@node"
	}
}
