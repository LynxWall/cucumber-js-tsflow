{
	"compilerOptions": {
		"esModuleInterop": true,
		"lib": ["es2022", "esnext.decorators"],
		"module": "node18",
		"strict": true,
		"noImplicitReturns": true,
		"resolveJsonModule": true,
		"sourceMap": true,
		"inlineSources": true,
		"skipLibCheck": true,
		"target": "es2022",
		"typeRoots": ["../node_modules/@types", "./src/types"],
	},
	"exclude": ["./src/transpilers/esm/*", "./test"]
}
